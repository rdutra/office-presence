# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=rodosmodernlife.firebaseapp.com
FIREBASE_DATABASE_URL=https://rodosmodernlife-default-rtdb.firebaseio.com/
FIREBASE_PROJECT_ID=rodosmodernlife
FIREBASE_STORAGE_BUCKET=rodosmodernlife.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK (for data sync script)
# Download service account key from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
