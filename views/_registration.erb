<div class="register-section">
  <h3 id="registrationTitle" style="margin: 0 0 0.5rem 0;">Register Your Device</h3>
  <div id="deviceInfo" class="small muted">Loading your device info...</div>
  <form id="registerForm" class="register-form" onsubmit="registerDevice(event)">
    <div class="form-group">
      <label for="personName">Your Name *</label>
      <input type="text" id="personName" placeholder="John Doe" required />
    </div>
    <div class="form-group">
      <label for="deviceName">Device Name (optional)</label>
      <input type="text" id="deviceName" placeholder="Laptop, Phone, etc." />
    </div>
    <div class="form-group">
      <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
        <input type="checkbox" id="visibleCheckbox" checked />
        <span>Show me on the presence list</span>
      </label>
      <div class="small muted" style="margin-top: 0.25rem;">Uncheck to keep your device mapped but hidden from public view</div>
    </div>
    <button type="submit" id="submitBtn" class="btn btn-primary">Register</button>
  </form>
  <div id="registerInfo" class="register-info info">Checking your device...</div>
  <div id="visibilityToggle" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #eee;">
    <button type="button" id="toggleVisibilityBtn" class="btn btn-secondary" onclick="toggleVisibility()">Toggle Visibility</button>
    <div id="visibilityInfo" class="small muted" style="margin-top: 0.5rem;"></div>
  </div>
</div>
