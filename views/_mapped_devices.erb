<div class="section">
  <h2>Mapped — Present <span class="badge ok"><%= mapped_present.length %></span></h2>
  <table id="mapped-table">
    <thead>
      <tr><th>Status</th><th>Person</th><th>Device</th><th>Last Seen</th><th>Hostname</th><th>IP</th><th>MAC</th><th>Device ID</th></tr>
    </thead>
    <tbody>
      <% if mapped_present.empty? %>
        <tr><td colspan="8" class="muted">No mapped people seen recently.</td></tr>
      <% else %>
        <% mapped_present.each do |r| %>
          <tr data-mac="<%= r[:mac] %>" data-last-seen="<%= r[:last_seen_utc] %>">
            <td><span class="status-indicator" data-status="<%= r[:status] %>">●</span></td>
            <td><strong>
              <% if r[:person] && r[:person] != '—' && !OfficePresence::Models::Person.anonymous_name?(r[:person]) %>
                <a href="/admin/person/<%= ERB::Util.url_encode(r[:person]) %>" style="text-decoration: none; color: #0969da;"><%= r[:person] %></a>
              <% else %>
                <%= r[:person] || '—' %>
              <% end %>
            </strong></td>
            <td><%= r[:device] || '—' %></td>
            <td><span class="timestamp" data-utc="<%= r[:last_seen_utc] %>"><%= r[:last_seen_utc] || '—' %></span></td>
            <td><%= r[:hostname] || '—' %></td>
            <td><%= r[:ip] || '—' %></td>
            <td class="mac"><%= r[:mac] || '—' %></td>
            <td class="mac"><%= r[:device_id] || '—' %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="section">
  <h2>Mapped — Not recently seen</h2>
  <table>
    <thead>
      <tr><th>Person</th><th>Device</th><th>Last Seen</th><th>Hostname</th><th>IP</th><th>MAC</th><th>Device ID</th></tr>
    </thead>
    <tbody>
      <% if mapped_absent.empty? %>
        <tr><td colspan="7" class="muted">—</td></tr>
      <% else %>
        <% mapped_absent.each do |r| %>
          <tr class="muted">
            <td><strong>
              <% if r[:person] && r[:person] != '—' && !OfficePresence::Models::Person.anonymous_name?(r[:person]) %>
                <a href="/admin/person/<%= ERB::Util.url_encode(r[:person]) %>" style="text-decoration: none; color: #0969da;"><%= r[:person] %></a>
              <% else %>
                <%= r[:person] || '—' %>
              <% end %>
            </strong></td>
            <td><%= r[:device] || '—' %></td>
            <td><span class="timestamp" data-utc="<%= r[:last_seen_utc] %>"><%= r[:last_seen_utc] || '—' %></span></td>
            <td><%= r[:hostname] || '—' %></td>
            <td><%= r[:ip] || '—' %></td>
            <td class="mac"><%= r[:mac] || '—' %></td>
            <td class="mac"><%= r[:device_id] || '—' %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
