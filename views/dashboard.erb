<!doctype html>
<html>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Look who bothered to come Dashboard</title>
    <link rel="stylesheet" href="/css/dashboard.css">
  </head>
  <body>
    <div class="container">
      <header>
        <span class="current-time" data-utc="<%= now.utc.strftime("%Y-%m-%d %H:%M:%S") %>"><%= now.strftime("%H:%M") %></span>
        <div class="header-title">
          <h1>🏢 Look who bothered to come</h1>
        </div>
        <div class="header-actions">
          <div class="date"><%= now.strftime("%A, %B %d") %></div>
          <button class="register-button" id="openRegistrationBtn" type="button">Register Your Device</button>
        </div>
      </header>

      <div class="stats">
        <div class="stat-card">
          <div class="stat-number"><%= present_count %></div>
          <div class="stat-label">In the Office 🎉</div>
        </div>
        <div class="stat-card">
          <div class="stat-number"><%= total_people %></div>
          <div class="stat-label">Team Members</div>
        </div>
      </div>

      <div class="columns">
        <div class="column">
          <div class="section-header">
            <span class="icon">👥</span> In the Office
          </div>
          <% if mapped_present.empty? %>
            <div class="empty-state">No one here yet — be the first! ☕</div>
          <% else %>
            <div class="people-list">
              <% mapped_present.each do |person| %>
                <div class="person-card status-<%= person[:status] %>">
                  <div class="person-avatar">
                    <%= person[:person][0].upcase %>
                  </div>
                  <div class="person-info">
                    <div class="person-name"><%= person[:person] %></div>
                    <div class="person-device"><%= person[:device] || 'Device' %></div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="right-column-sections">
          <div class="right-section">
            <div class="section-header">
              <span class="icon">🏆</span> Top 3 Champions
            </div>
            <% if top_attendees.empty? %>
              <div class="empty-state">No data yet</div>
            <% else %>
              <div class="podium-container">
                <% top_attendees.take(3).each_with_index do |attendee, index| %>
                  <div class="podium-item rank-<%= index + 1 %>">
                    <div class="podium-rank"><%= ['🥇', '🥈', '🥉'][index] %></div>
                    <div class="podium-info">
                      <div class="podium-name"><%= attendee[:person] %></div>
                      <div class="podium-days"><%= attendee[:days] %> days</div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="right-section">
            <div class="section-header">
              <span class="icon">📅</span> Earlier Today
            </div>
            <% if mapped_absent.empty? %>
              <div class="empty-state">No one has left yet</div>
            <% else %>
              <div class="recent-list">
                <% mapped_absent.take(8).each do |person| %>
                  <div class="recent-item">
                    <div class="recent-name"><%= person[:person] %></div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div id="registrationModal" class="registration-modal" aria-hidden="true">
      <div class="modal-overlay" data-close-modal></div>
      <div class="modal-content" role="dialog" aria-modal="true" aria-label="Register your device">
        <button type="button" class="modal-close" id="closeRegistrationBtn" aria-label="Close registration form">&times;</button>
        <%= erb :_registration %>
      </div>
    </div>

    <script src="/js/timezone.js"></script>
    <script src="/js/registration.js"></script>
    <script src="/js/dashboard.js"></script>
  </body>
</html>
