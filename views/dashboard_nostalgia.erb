<!doctype html>
<html>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Noche de la Nostalgia - Mix de Oficina</title>
    <link rel="stylesheet" href="/css/nostalgia.css">
    <link rel="stylesheet" href="/css/registration_modal.css">
  </head>
  <body class="nostalgia-theme">
    <div class="nostalgia-bg">
      <div class="light-beam beam-a"></div>
      <div class="light-beam beam-b"></div>
    </div>

    <main class="nostalgia-stage">
      <div id="dj-banner" class="dj-banner" aria-hidden="true">
        <div class="dj-banner-content">
          <div class="dj-banner-photo-wrapper">
            <img id="dj-banner-photo" src="" alt="" style="display:none;">
            <div id="dj-banner-avatar" class="dj-banner-avatar"></div>
          </div>
          <div class="dj-banner-text">
            <span>Now playing -</span>
            <strong id="dj-banner-name"></strong>
          </div>
        </div>
      </div>
      <section class="tv-poster" aria-label="Mix de oficina para la Noche de la Nostalgia">
        <% track_people = mapped_present.reject { |person| person[:person].to_s.start_with?("Anonymous") } %>
        <section class="album-cover" aria-label="Tapa del disco Now Office 9">
          <div class="cover-topline">
            <span>Incluye todos los clásicos de la oficina</span>
            <span id="ns-current-time" data-utc="<%= now.utc.strftime("%Y-%m-%d %H:%M:%S") %>"><%= now.strftime("%H:%M") %></span>
          </div>
          <div class="cover-cubes" aria-hidden="true">
            <% 16.times do |index| %>
              <span style="--i:<%= index %>"></span>
            <% end %>
          </div>
          <div class="now-label">
            <span>NOW</span>
            <strong>ESTO SÍ ES OFICINA!</strong>
            <b>9</b>
          </div>
          <div class="chart-hits"><span id="ns-total-people"><%= track_people.length %></span> HITS DE OFICINA!</div>
          <img class="disco-ball" src="/img/nostalgia/disco-ball.png" alt="Bola de espejos">
        </section>

        <section class="track-panel" aria-label="Lista de temas del CD de oficina">
          <div class="track-header">
            <span>CD 94.7</span>
            <strong>Lista de temas</strong>
            <small>La Noche de la Nostalgia</small>
          </div>
          <ol class="track-list" id="ns-track-list">
            <% track_people.each_with_index do |person, index| %>
              <li>
                <span class="track-num"><%= (index + 1).to_s.rjust(2, "0") %></span>
                <span class="track-name"><%= [person[:person], person[:medal]].compact.join(" ") %></span>
                <span class="track-status">sonando</span>
              </li>
            <% end %>
          </ol>
        </section>

        <aside class="nostalgia-side">
          <div class="brand-cluster">
            <img class="concierto-logo" src="/img/nostalgia/concierto-947-logo.svg" alt="94.7 FM Concierto">
            <img class="punta-bus" src="/img/nostalgia/concierto-punta-bus.png" alt="Concierto Punta bus">
          </div>
          <img class="berch-sticker" src="/img/nostalgia/berch-recuerdos-remix.png" alt="La Noche de los Recuerdos by Berch Rupenian remix poster">
          <div class="stats-stack">
            <div class="on-air-box">
              <span>AL AIRE</span>
              <strong id="ns-present-count"><%= track_people.length %></strong>
              <small>en la pista</small>
            </div>
            <div class="stat-tape">
              <span>Récord</span>
              <strong id="ns-daily-record"><%= daily_record %></strong>
            </div>
            <div class="stat-tape">
              <span>Histórico</span>
              <strong id="ns-all-time-record"><%= all_time_record %></strong>
            </div>
          </div>
          <div class="performance-board">
            <section class="winner-card" aria-label="Ganador de la semana anterior">
              <span>Ganador anterior</span>
              <strong id="ns-last-winner-name"><%= last_week_winner ? last_week_winner[:person] : "Sin ganador" %></strong>
              <small id="ns-last-winner-meta">
                <% if last_week_winner %>
                  <%= last_week_winner[:days] %> días
                <% else %>
                  --
                <% end %>
              </small>
            </section>
            <section class="ranking-card" aria-label="Ranking semanal">
              <span>Ranking semanal</span>
              <div id="ns-top-attendees">
                <% top_attendees.take(5).each_with_index do |attendee, index| %>
                  <div class="spin-row">
                    <b><%= index + 1 %></b>
                    <span><%= attendee[:person] %></span>
                    <em><%= attendee[:days] %></em>
                  </div>
                <% end %>
              </div>
            </section>
          </div>
          <section class="music-card" aria-label="Playlist colaborativa">
            <div class="music-header">
              <span>Playlist nostalgia</span>
              <div class="music-links">
                <a href="https://music.youtube.com/playlist?list=PLT3Ef56-3Nl37ycrVTMM5jfs7zRf264SP&si=GWkd_gMHXBOwHZqr" target="_blank" rel="noopener">Escuchar</a>
                <a href="https://music.youtube.com/playlist?list=PLT3Ef56-3Nl37ycrVTMM5jfs7zRf264SP&jct=LbFEiQul1_4XTA8TMvjfjA" target="_blank" rel="noopener">Sumar tema</a>
              </div>
            </div>
            <iframe
              id="nostalgia-youtube-player"
              title="Playlist Noche de la Nostalgia"
              src="https://www.youtube.com/embed?enablejsapi=1&listType=playlist&list=PLT3Ef56-3Nl37ycrVTMM5jfs7zRf264SP"
              allow="autoplay; encrypted-media; picture-in-picture"
              loading="lazy">
            </iframe>
          </section>
          <button class="register-button-ns" id="openRegistrationBtn" type="button">Registrar dispositivo</button>
        </aside>
      </section>
    </main>

    <img class="drop-disco-ball" src="/img/nostalgia/disco-ball.png" alt="Bola de espejos">

    <div id="registrationModal" class="registration-modal" aria-hidden="true">
      <div class="modal-overlay" data-close-modal></div>
      <div class="modal-content" role="dialog" aria-modal="true" aria-label="Registrar dispositivo">
        <button type="button" class="modal-close" id="closeRegistrationBtn" aria-label="Cerrar formulario">&times;</button>
        <%= erb :_registration %>
      </div>
    </div>

    <script src="/js/timezone.js"></script>
    <script src="/js/presence.js"></script>
    <script src="/js/registration.js"></script>
    <script src="/js/nostalgia-dashboard.js"></script>
    <script src="/js/youtube-playlist.js"></script>
  </body>
</html>
