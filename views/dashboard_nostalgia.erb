<!doctype html>
<html>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Noche de la Nostalgia - Office Mix</title>
    <link rel="stylesheet" href="/css/nostalgia.css">
    <link rel="stylesheet" href="/css/registration_modal.css">
  </head>
  <body class="nostalgia-theme">
    <div class="nostalgia-bg">
      <div class="light-beam beam-a"></div>
      <div class="light-beam beam-b"></div>
      <img class="disco-ball" src="/img/nostalgia/disco-ball.png" alt="Disco ball">
    </div>

    <main class="nostalgia-stage">
      <section class="tv-poster" aria-label="Noche de la Nostalgia office mix">
        <section class="album-cover" aria-label="Now That's What I Call Office 9 album cover">
          <div class="cover-topline">
            <span>Includes every office classic</span>
            <span id="ns-current-time" data-utc="<%= now.utc.strftime("%Y-%m-%d %H:%M:%S") %>"><%= now.strftime("%H:%M") %></span>
          </div>
          <div class="cover-cubes" aria-hidden="true">
            <% 16.times do |index| %>
              <span style="--i:<%= index %>"></span>
            <% end %>
          </div>
          <div class="now-label">
            <span>NOW</span>
            <strong>THAT'S WHAT I CALL OFFICE!</strong>
            <b>9</b>
          </div>
          <div class="chart-hits"><span id="ns-total-people"><%= total_people %></span> CHART-TOPPING HITS!</div>
          <img class="disco-ball" src="/img/nostalgia/disco-ball.png" alt="Disco ball">
        </section>

        <section class="track-panel" aria-label="Office CD track list">
          <div class="track-header">
            <span>CD 94.7</span>
            <strong>Track List</strong>
            <small>La Noche de la Nostalgia</small>
          </div>
          <ol class="track-list" id="ns-track-list">
            <% (mapped_present + mapped_absent).each_with_index do |person, index| %>
              <li>
                <span class="track-num"><%= (index + 1).to_s.rjust(2, "0") %></span>
                <span class="track-name"><%= [person[:person], person[:medal]].compact.join(" ") %></span>
                <span class="track-status"><%= person[:status] == "active" ? "playing" : "rewind" %></span>
              </li>
            <% end %>
          </ol>
        </section>

        <aside class="nostalgia-side">
          <div class="brand-cluster">
            <img class="concierto-logo" src="/img/nostalgia/concierto-947-logo.svg" alt="94.7 FM Concierto">
            <img class="punta-bus" src="/img/nostalgia/concierto-punta-bus.png" alt="Concierto Punta bus">
          </div>
          <img class="berch-sticker" src="/img/nostalgia/berch-recuerdos-remix.png" alt="La Noche de los Recuerdos by Berch Rupenian remix poster">
          <div class="stats-stack">
            <div class="on-air-box">
              <span>AL AIRE</span>
              <strong id="ns-present-count"><%= present_count %></strong>
              <small>en la pista</small>
            </div>
            <div class="stat-tape">
              <span>Record</span>
              <strong id="ns-daily-record"><%= daily_record %></strong>
            </div>
            <div class="stat-tape">
              <span>Histórico</span>
              <strong id="ns-all-time-record"><%= all_time_record %></strong>
            </div>
          </div>
          <div class="performance-board">
            <section class="winner-card" aria-label="Previous week winner">
              <span>Ganador anterior</span>
              <strong id="ns-last-winner-name"><%= last_week_winner ? last_week_winner[:person] : "Sin ganador" %></strong>
              <small id="ns-last-winner-meta">
                <% if last_week_winner %>
                  <%= last_week_winner[:days] %> dias
                <% else %>
                  --
                <% end %>
              </small>
            </section>
            <section class="ranking-card" aria-label="Weekly ranking">
              <span>Ranking semanal</span>
              <div id="ns-top-attendees">
                <% top_attendees.take(5).each_with_index do |attendee, index| %>
                  <div class="spin-row">
                    <b><%= index + 1 %></b>
                    <span><%= attendee[:person] %></span>
                    <em><%= attendee[:days] %></em>
                  </div>
                <% end %>
              </div>
            </section>
          </div>
          <button class="register-button-ns" id="openRegistrationBtn" type="button">Register Device</button>
        </aside>
      </section>
    </main>

    <div id="registrationModal" class="registration-modal" aria-hidden="true">
      <div class="modal-overlay" data-close-modal></div>
      <div class="modal-content" role="dialog" aria-modal="true" aria-label="Register your device">
        <button type="button" class="modal-close" id="closeRegistrationBtn" aria-label="Close registration form">&times;</button>
        <%= erb :_registration %>
      </div>
    </div>

    <script src="/js/timezone.js"></script>
    <script src="/js/presence.js"></script>
    <script src="/js/registration.js"></script>
    <script src="/js/nostalgia-dashboard.js"></script>
  </body>
</html>
